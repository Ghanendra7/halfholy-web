<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {{ content_for_header }}

    <script type="speculationrules">
    {
      "prerender": [
        {
          "source": "document",
          "where": {
            "and": [
              { "href_matches": "/*\\?*" },
              { "not": { "href_matches": "/cart*" } },
              { "not": { "href_matches": "/checkout*" } },
              { "not": { "href_matches": "/admin*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
    </script>

    {{ 'AntiqueLegacy-Light.otf' | asset_url | preload_tag: as: 'font', type: 'font/otf', crossorigin: 'anonymous' }}
    {{ 'FragmentMono-Regular.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf', crossorigin: 'anonymous' }}
    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}

    <style>
      @font-face {
        font-family: 'Antique Legacy';
        src: url("{{ 'AntiqueLegacy-Light.otf' | asset_url }}") format('opentype');
        font-weight: 300 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Antique Legacy';
        src: url("{{ 'AntiqueLegacy-LightItalic.otf' | asset_url }}") format('opentype');
        font-weight: 300 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Fragment Mono';
        src: url("{{ 'FragmentMono-Regular.ttf' | asset_url }}") format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Fragment Mono';
        src: url("{{ 'FragmentMono-Italic.ttf' | asset_url }}") format('truetype');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }

      :root {
        --color-brand-bg: #FFFFFF;
        --color-brand-card: #F1F1F1;
        --color-brand-footer: #E6E9EA;
        --color-brand-border: #CBD0D3;
        --color-brand-purple: #9022B8;
      }

      html, body {
        background-color: #FFFFFF;
        color: #000000;
        margin: 0;
        padding: 0;
      }
    </style>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="site-body min-h-screen flex flex-col">
    <a class="sr-only" href="#MainContent">
      Skip to content
    </a>

    {% section 'header' %}

    <main id="MainContent" class="site-main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% render 'cart-drawer' %}
  </body>
</html>