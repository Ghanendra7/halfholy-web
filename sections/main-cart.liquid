<section class="cart-page">
  <div class="cart-page__container">
    <div class="cart-page__header">
      <h1 class="cart-page__title">Shopping Bag <span class="cart-page__count" data-cart-count>({{ cart.item_count }})</span></h1>
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
        <ul class="cart-page__items" role="list">
          {% for item in cart.items %}
            <li class="cart-page__item">
              <div class="cart-page__item-media">
                {% if item.image %}
                  {{ item.image | image_url: width: 300 | image_tag: class: 'cart-page__item-image', loading: 'lazy', decoding: 'async', alt: item.title | escape }}
                {% else %}
                  <div class="cart-page__item-placeholder"></div>
                {% endif %}
              </div>

              <div class="cart-page__item-details">
                <div class="cart-page__item-header">
                  <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                  <span class="cart-page__item-price">
                    {{ item.final_line_price | money_without_trailing_zeros | remove: '$' | remove: '£' | remove: '€' | strip }} <span class="cart-page__item-currency">{{ cart.currency.iso_code }}</span>
                  </span>
                </div>

                {% unless item.product.has_only_default_variant %}
                  <div class="cart-page__item-variant">{{ item.variant.title }}</div>
                {% endunless %}

                <div class="cart-page__item-actions">
                  <div class="cart-page__qty-control" role="group" aria-label="Quantity selector">
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="cart-page__qty-btn" aria-label="Decrease quantity">−</a>
                    <span class="cart-page__qty-value">{{ item.quantity }}</span>
                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="cart-page__qty-btn" aria-label="Increase quantity">+</a>
                  </div>

                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="cart-page__item-remove">Remove</a>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>

        <div class="cart-page__footer">
          <div class="cart-page__summary-row">
            <span class="cart-page__summary-label">Subtotal</span>
            <span class="cart-page__summary-value">
              {{ cart.total_price | money_without_trailing_zeros | remove: '$' | remove: '£' | remove: '€' | strip }} <span class="cart-page__summary-currency">{{ cart.currency.iso_code }}</span>
            </span>
          </div>
          <p class="cart-page__tax-note">Shipping & taxes calculated at checkout</p>
          <button type="submit" name="checkout" class="cart-page__checkout-btn">
            Proceed to Checkout
          </button>
        </div>
      </form>
    {% else %}
      <div class="cart-page__empty">
        <p class="cart-page__empty-text">Your shopping bag is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-page__empty-btn">
          Explore Shop
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}