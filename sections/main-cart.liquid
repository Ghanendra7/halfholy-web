<section class="w-full px-6 md:px-12 py-16 bg-[#E6E9EA]">
  <div class="max-w-2xl mx-auto">
    <h1 class="text-xs font-mono uppercase tracking-widest hairline-b pb-4 mb-8">Shopping Bag</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="space-y-8">
        <ul class="divide-y divide-[#CBD0D3]">
          {% for item in cart.items %}
            <li class="py-6 flex gap-6">
              {% if item.image %}
                <div class="w-24 h-28 bg-white border border-[#CBD0D3] p-1 shrink-0">
                  {{ item.image | image_url: width: 300 | image_tag: class: 'w-full h-full object-contain' }}
                </div>
              {% endif %}
              <div class="flex-1 flex flex-col justify-between">
                <div>
                  <h2 class="text-sm uppercase font-medium">{{ item.product.title }}</h2>
                  <p class="text-xs font-mono text-[#666666] mt-1">{{ item.final_price | money }}</p>
                </div>
                <div class="flex items-center justify-between text-xs font-mono">
                  <span>Quantity: {{ item.quantity }}</span>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="underline hover:text-[#9022B8]">Remove</a>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>

        <div class="hairline-t pt-6 space-y-4 text-xs font-mono">
          <div class="flex justify-between uppercase">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <button type="submit" name="checkout" class="w-full bg-[#9022B8] hover:bg-[#7E1DA2] text-white py-3 px-6 uppercase tracking-wider transition-colors cursor-pointer">
            Proceed to Checkout
          </button>
        </div>
      </form>
    {% else %}
      <div class="py-16 text-center">
        <p class="text-xs font-mono uppercase text-[#666666] mb-6">Your shopping bag is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-block hairline-all px-6 py-2.5 text-xs font-mono uppercase hover:bg-black hover:text-white transition-colors">
          Explore Collection
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
