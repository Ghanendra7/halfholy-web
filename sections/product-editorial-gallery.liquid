{% assign editorial_images = product.metafields.custom.gallery.value | default: product.metafields.custom.editorial_gallery.value %}

{% if editorial_images != blank or section.blocks.size > 0 %}
  <section class="w-full bg-[#E6E9EA] hairline-b content-visibility-auto">
    {% if section.settings.heading != blank %}
      <div class="px-6 md:px-8 py-4 hairline-b flex items-center justify-between text-xs font-mono uppercase tracking-widest text-[#5C6265]">
        <span>{{ section.settings.heading }}</span>
        <span class="text-[#0A0A0A] font-serif italic lowercase tracking-normal">{{ product.title }}</span>
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 -space-x-[1px] -space-y-[1px]">
      {% if editorial_images != blank %}
        {% for image in editorial_images %}
          <div class="relative bg-[#E5E5E5] hairline-all aspect-4/5 overflow-hidden group">
            {{ image | image_url: width: 1400 | image_tag: 
              class: 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-102',
              loading: 'lazy',
              decoding: 'async'
            }}
          </div>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <div class="relative bg-[#E5E5E5] hairline-all aspect-4/5 overflow-hidden group" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1400 | image_tag: 
                class: 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-102',
                loading: 'lazy',
                decoding: 'async'
              }}
            {% else %}
              <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-xs font-mono text-[#8E9598]">
                <span>CAMPAIGN STILL {{ forloop.index }}</span>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Product Editorial Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CAMPAIGN ARCHIVE"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Fallback Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Editorial Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
