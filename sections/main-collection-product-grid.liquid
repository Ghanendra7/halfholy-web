<section class="w-full bg-white min-h-[calc(100vh-117px)]">
  <div class="w-full px-[10px] md:px-4 pt-[50px] pb-10">
    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-2 md:gap-x-1 gap-y-4 md:gap-y-6">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="mt-12 py-8 flex justify-center items-center space-x-6 text-[10px] font-mono tracking-[2px] uppercase text-black">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="hover:opacity-60 transition-opacity">&larr; PREVIOUS</a>
            {% endif %}
            <span class="text-[#888888]">PAGE {{ paginate.current_page }} OF {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="hover:opacity-60 transition-opacity">NEXT &rarr;</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        {% comment %}
          Figma Exact Reference Showcase:
          Renders 8 sample products matching the Figma "Shop" and "Shop - Mobile" frames.
          Card 2 showcases the active/hover state with purple outline and price display.
        {% endcomment %}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-x-2 md:gap-x-1 gap-y-4 md:gap-y-6">
          {% for i in (1..8) %}
            {% if i == 2 %}
              {% render 'product-card', is_sample: true, is_active: true %}
            {% else %}
              {% render 'product-card', is_sample: true, is_active: false %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
