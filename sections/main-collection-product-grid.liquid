<section 
  id="shopify-section-{{ section.id }}"
  class="collection-section"
  aria-label="Products"
>
  <div class="collection-grid-container">
    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <ul class="collection-grid-items" role="list">
          {% for product in collection.products %}
            {% assign is_eager = false %}
            {% if forloop.index <= 4 %}
              {% assign is_eager = true %}
            {% endif %}
            <li role="listitem">
              {% render 'product-card', product: product, is_eager: is_eager %}
            </li>
          {% endfor %}
        </ul>

        {% if paginate.pages > 1 %}
          <div class="collection-pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}">&larr; PREVIOUS</a>
            {% endif %}
            <span class="collection-pagination__info">PAGE {{ paginate.current_page }} OF {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}">NEXT &rarr;</a>
            {% endif %}
          </div>
        {% endif %}
      {% else %}
        <ul class="collection-grid-items" role="list">
          {% for i in (1..8) %}
            {% assign is_eager = false %}
            {% if i <= 4 %}
              {% assign is_eager = true %}
            {% endif %}
            <li role="listitem">
              {% if i == 2 %}
                {% render 'product-card', is_sample: true, is_active: true, is_eager: is_eager %}
              {% else %}
                {% render 'product-card', is_sample: true, is_active: false, is_eager: is_eager %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 12,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal_desktop",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Desktop Horizontal Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_col_desktop",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Desktop Column Gap",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap_row_desktop",
      "min": 4,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Desktop Row Gap",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 12,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile Horizontal Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_col_mobile",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Mobile Column Gap",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap_row_mobile",
      "min": 4,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Mobile Row Gap",
      "default": 12
    }
  ]
}
{% endschema %}