<section class="section-404" data-section-id="{{ section.id }}">
  <div class="section-404__container">
    <h1 class="section-404__title p1">
      {{ section.settings.title | default: 'PAGE NOT FOUND' }}
    </h1>
    {%- if section.settings.link_text != blank -%}
      <a href="{{ section.settings.link_url | default: routes.root_url }}" class="section-404__link p1">
        {{ section.settings.link_text }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-404-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "PAGE NOT FOUND"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Label",
      "default": "RETURN HOME"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link Destination"
    }
  ]
}
{% endschema %}
