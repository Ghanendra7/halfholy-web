<section class="w-full bg-[#EFEFEF] hairline-b">
  {% if section.settings.heading != blank %}
    <div class="px-6 md:px-8 py-4 hairline-b flex items-center justify-between text-xs font-mono uppercase tracking-widest text-[#777777]">
      <span>{{ section.settings.heading }}</span>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="text-[#0A0A0A] underline hover:text-[#8000FF]">VIEW ALL</a>
      {% endif %}
    </div>
  {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-3 -space-x-[1px] -space-y-[1px]">
    {% for block in section.blocks %}
      <div class="relative bg-[#E5E5E5] hairline-all aspect-4/5 overflow-hidden group" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1000 | image_tag: 
            class: 'w-full h-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-102',
            loading: 'lazy'
          }}
        {% else %}
          <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center text-xs font-mono text-[#888888]">
            <span>LOOKBOOK {{ forloop.index }}</span>
            <span class="text-[10px] mt-2 text-[#AAAAAA]">{{ block.settings.caption | default: 'CAMPAIGN STILL' }}</span>
          </div>
        {% endif %}

        {% if block.settings.caption != blank %}
          <div class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black/60 to-transparent text-white text-[11px] font-mono uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
            {{ block.settings.caption }}
          </div>
        {% endif %}
      </div>
    {% else %}
      {% for i in (1..3) %}
        <div class="relative bg-[#E5E5E5] hairline-all aspect-4/5 flex items-center justify-center text-xs font-mono text-[#888888]">
          LOOKBOOK STILL {{ i }}
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CAMPAIGN ARCHIVE"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "CEREMONY I"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
