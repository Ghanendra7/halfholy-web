<header class="sticky top-0 z-40 bg-[#EFEFEF]/95 backdrop-blur-xs hairline-b w-full">
  <div class="w-full px-6 md:px-8 py-3.5 flex items-center justify-between">
    <!-- Left Navigation -->
    <nav class="flex items-center space-x-6 text-xs uppercase tracking-tight text-[#0A0A0A]">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="hover:opacity-60 transition-opacity {% if link.active %}underline underline-offset-4{% endif %}">
          {{ link.title }}
        </a>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="hover:opacity-60 transition-opacity">Shop</a>
        <a href="/pages/about" class="hover:opacity-60 transition-opacity">About</a>
        <a href="/pages/campaigns" class="hover:opacity-60 transition-opacity">Campaigns</a>
      {% endfor %}
    </nav>

    <!-- Center Wordmark -->
    <div class="text-center">
      <a href="{{ routes.root_url }}" class="text-sm md:text-base font-serif tracking-[0.25em] uppercase hover:opacity-80 transition-opacity">
        {{ section.settings.brand_text | default: 'HALF HOLY' }}
      </a>
    </div>

    <!-- Right Bag / Cart -->
    <div class="flex items-center">
      <button 
        type="button" 
        onclick="document.querySelector('cart-drawer').open()" 
        class="text-xs uppercase tracking-tight hover:opacity-60 transition-opacity cursor-pointer"
        aria-label="Cart"
      >
        Cart <span data-cart-count>({{ cart.item_count }})</span>
      </button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Wordmark",
      "default": "HALF HOLY"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
