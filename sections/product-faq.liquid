{% liquid
  assign faq_image = product.metafields.custom.faq_image.value | default: section.settings.image
  assign heading_text = section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS'
%}

<section class="faq hairline-t" data-faq-section>
  <div class="faq__container">
    <div class="faq__media-col hairline-r">
      {% if faq_image != blank %}
        {{ faq_image | image_url: width: 1600 | image_tag: class: 'faq__media-img', loading: 'lazy', decoding: 'async', alt: heading_text }}
      {% else %}
        <img src="{{ 'faq-campaign-image.jpg' | asset_url }}" alt="{{ product.title | default: 'Halfholy FAQ' | escape }}" class="faq__media-img" width="756" height="983" loading="lazy" decoding="async">
      {% endif %}
    </div>

    <div class="faq__content-col">
      <span class="faq__heading t2">{{ heading_text }}</span>

      <div class="faq__inner">
        <accordion-drawer class="faq__list">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <details class="faq__item {% if block.settings.default_open %}is-open{% endif %}" {% if block.settings.default_open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="faq__summary t2">
                  <span>{{ block.settings.title }}</span>
                  <span class="faq__icon" aria-hidden="true"></span>
                </summary>
                <div class="faq__content p1">
                  {{ block.settings.answer }}
                </div>
              </details>
            {% endfor %}
          {% else %}
            <details class="faq__item is-open" open>
              <summary class="faq__summary t2">
                <span>RETURNS &amp; EXCHANGES</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__content p1">
                <p>We accept returns of unopened, unused products within [30] days of delivery. For hygiene reasons, we cannot accept returns of opened or used lip products. If your order arrives damaged or incorrect, email <a href="mailto:info@halfholy.nyc">info@halfholy.nyc</a> within [7] days of delivery with your order number and a photo. We will send a replacement or issue a full refund.</p>
                <p>To start a return, email <a href="mailto:info@halfholy.nyc">info@halfholy.nyc</a> with your order number. Refunds go back to the original payment method within [5 to 10] business days after we receive the return. Return shipping is [paid by the customer] unless the item arrived damaged or incorrect.</p>
                <p>We do not offer direct exchanges. Return the original item and place a new order.</p>
              </div>
            </details>

            <details class="faq__item">
              <summary class="faq__summary t2">
                <span>WHAT'S THE CONTACT INFORMATION?</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__content p1">
                <p>For general inquiries, order questions, or press, reach us at <a href="mailto:info@halfholy.nyc">info@halfholy.nyc</a>. Our team is available Monday through Friday, 9am to 6pm EST.</p>
              </div>
            </details>

            <details class="faq__item">
              <summary class="faq__summary t2">
                <span>WHAT PAYMENT METHODS DO YOU ACCEPT?</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__content p1">
                <p>We accept Visa, Mastercard, American Express, Discover, Apple Pay, Google Pay, and Shop Pay. All payments are processed securely by [Shopify Payments / Stripe]. Halfholy does not store your card details.</p>
              </div>
            </details>

            <details class="faq__item">
              <summary class="faq__summary t2">
                <span>WHAT'S THE CONTACT INFORMATION?</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__content p1">
                <p>Standard domestic shipping takes 3–5 business days. Express options are available at checkout. International orders typically arrive within 7–14 business days depending on customs clearance.</p>
              </div>
            </details>
          {% endif %}
        </accordion-drawer>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign Image"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "RETURNS & EXCHANGES"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept returns of unopened, unused products within [30] days of delivery.</p>"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "title": "RETURNS & EXCHANGES",
            "default_open": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "WHAT'S THE CONTACT INFORMATION?",
            "default_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "WHAT PAYMENT METHODS DO YOU ACCEPT?",
            "default_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "WHAT'S THE CONTACT INFORMATION?",
            "default_open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
