<section class="legal-page" data-section-id="{{ section.id }}">
  <div class="legal-page__container">
    {%- if page.title != blank and section.settings.show_title -%}
      <h1 class="legal-page__title p1">{{ page.title }}</h1>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="legal-page__content p1">
        {{ page.content }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Page Title",
      "default": true
    }
  ]
}
{% endschema %}
