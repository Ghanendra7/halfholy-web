{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_media = current_variant.featured_media
  | default: product.featured_media
  | default: product.media[0]
%}
{% assign has_real_media = false %}
{% if product.media.size > 0 %}
  {% assign has_real_media = true %}
{% endif %}

{% if product %}
  {% assign raw_price = current_variant.price
    | money_without_trailing_zeros
    | remove: '$'
    | remove: '£'
    | remove: '€'
    | strip
  %}
  {% assign currency_code = cart.currency.iso_code | default: 'USD' %}
{% else %}
  {% assign raw_price = '50.00' %}
  {% assign currency_code = 'USD' %}
{% endif %}

{% assign has_selling_plans = false %}
{% assign default_selling_plan = null %}
{% assign max_savings = 0 %}
{% if product.selling_plan_groups.size > 0 %}
  {% assign has_selling_plans = true %}
  {% assign default_selling_plan_group = product.selling_plan_groups[0] %}
  {% assign default_selling_plan = default_selling_plan_group.selling_plans[0] %}
  {% for plan in default_selling_plan_group.selling_plans %}
    {% for adj in plan.price_adjustments %}
      {% if adj.value_type == 'percentage' and adj.value > max_savings %}
        {% assign max_savings = adj.value %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% elsif product == blank %}
  {% assign has_selling_plans = true %}
  {% assign max_savings = 6 %}
{% endif %}

<section class="product-purchase" data-product-purchase-section>
  <product-gallery class="product-purchase__container">
    <div class="product-purchase__media-column">
      <div class="product-purchase__thumbnails" role="tablist" aria-label="Product media gallery">
        {% if has_real_media %}
          {% for media in product.media %}
            <button
              type="button"
              class="product-purchase__thumb {% if forloop.first %}is-active{% endif %}"
              data-thumb-index="{{ forloop.index0 }}"
              data-full-src="{{ media | image_url: width: 1400 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="View product image {{ forloop.index }}"
            >
              {{ media | image_url: width: 120 | image_tag: loading: 'lazy', decoding: 'async', alt: product.title }}
            </button>
          {% endfor %}
        {% else %}
          <button
            type="button"
            class="product-purchase__thumb"
            data-thumb-index="0"
            data-full-src="{{ 'holy-balm-thumb-1.png' | asset_url }}"
            role="tab"
            aria-selected="false"
            aria-label="View product image 1"
          >
            <img
              src="{{ 'holy-balm-thumb-1.png' | asset_url }}"
              alt="Holy Balm view 1"
              width="85"
              height="114"
              loading="lazy"
              decoding="async"
            >
          </button>
          <button
            type="button"
            class="product-purchase__thumb is-active"
            data-thumb-index="1"
            data-full-src="{{ 'holy-balm-main.png' | asset_url }}"
            role="tab"
            aria-selected="true"
            aria-label="View product image 2"
          >
            <img
              src="{{ 'holy-balm-thumb-2.png' | asset_url }}"
              alt="Holy Balm view 2"
              width="85"
              height="114"
              loading="eager"
              decoding="async"
            >
          </button>
          <button
            type="button"
            class="product-purchase__thumb"
            data-thumb-index="2"
            data-full-src="{{ 'holy-balm-thumb-3.png' | asset_url }}"
            role="tab"
            aria-selected="false"
            aria-label="View product image 3"
          >
            <img
              src="{{ 'holy-balm-thumb-3.png' | asset_url }}"
              alt="Holy Balm view 3"
              width="85"
              height="114"
              loading="lazy"
              decoding="async"
            >
          </button>
          <button
            type="button"
            class="product-purchase__thumb"
            data-thumb-index="3"
            data-full-src="{{ 'holy-balm-thumb-4.png' | asset_url }}"
            role="tab"
            aria-selected="false"
            aria-label="View product image 4"
          >
            <img
              src="{{ 'holy-balm-thumb-4.png' | asset_url }}"
              alt="Holy Balm view 4"
              width="85"
              height="114"
              loading="lazy"
              decoding="async"
            >
          </button>
        {% endif %}
      </div>

      <div class="product-purchase__featured-media" data-featured-media>
        {% if has_real_media %}
          {{
            featured_media
            | image_url: width: 1500
            | image_tag:
              class: 'product-purchase__featured-image',
              data-main-image: '',
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              alt: product.title
          }}
        {% else %}
          <img
            src="{{ 'holy-balm-main.png' | asset_url }}"
            alt="{{ product.title | default: 'Holy Balm' }}"
            class="product-purchase__featured-image"
            data-main-image
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="758"
            height="982"
          >
        {% endif %}
      </div>
    </div>

    <div class="product-purchase__details-column">
      <div class="product-purchase__details">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              <div class="product-purchase__app-block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {% when 'category' %}
              <div class="product-purchase__category p1" {{ block.shopify_attributes }}>
                {{ product.type | default: 'Lip Products' }}
              </div>

            {% when 'title' %}
              <h1 class="product-purchase__title t1" {{ block.shopify_attributes }}>
                {{ product.title | default: 'Holy Balm' }}
              </h1>

            {% when 'price' %}
              <div class="product-purchase__price t2" data-product-price {{ block.shopify_attributes }}>
                <span class="product-purchase__price-amount">{{ raw_price }}</span>
                <span class="product-purchase__currency t4">{{ currency_code }}</span>
              </div>

            {% when 'description' %}
              <div class="product-purchase__description p1" {{ block.shopify_attributes }}>
                {% if product.description != blank %}
                  {{ product.description }}
                {% else %}
                  <p>
                    A conditioning lip balm with [peppermint], housed in a [machined aluminum] case designed to be
                    carried and kept. It goes on clear, leaves a soft finish, and gives a cool tingle on contact. Keep
                    it in a pocket, a bag, or on the nightstand.
                  </p>
                {% endif %}
              </div>

            {% when 'ingredients' %}
              {% assign ingredients_data = product.metafields.custom.ingredients.value
                | default: product.metafields.custom.ingredients
                | default: product.metafields.custom.specifications.value
                | default: product.metafields.custom.specifications
              %}
              <div class="product-purchase__ingredients t6" {{ block.shopify_attributes }}>
                {% if ingredients_data != blank %}
                  {{ ingredients_data | newline_to_br }}
                {% else %}
                  <span>Ceramide NP</span>
                  <span>Squalane, Butryospermum Parkii</span>
                  <span>Shea Butter</span>
                  <span>Bis-Diglyceryl Polyacyladipate-2</span>
                  <span>Ricinus Communis Seed Oil</span>
                  <span>Butyrospermum Parkii Butter</span>
                {% endif %}
              </div>

            {% when 'variant_picker' %}
              <div class="product-purchase__variant-picker" {{ block.shopify_attributes }}>
                {% if product.variants.size > 1 %}
                  <variant-selector data-url="{{ product.url }}" class="product-purchase__options">
                    {% for option in product.options_with_values %}
                      {% assign option_name_downcase = option.name | downcase %}
                      <fieldset class="product-purchase__option-group">
                        <legend class="product-purchase__option-label t2">{{ option.name }}</legend>
                        <div class="product-purchase__option-values {% if option_name_downcase == 'size' %}product-purchase__option-values--size{% endif %}">
                          {% for value in option.values %}
                            <label class="product-purchase__option-item">
                              <input
                                type="radio"
                                name="{{ option.name }}"
                                value="{{ value | escape }}"
                                class="product-purchase__option-input"
                                {% if option.selected_value == value %}
                                  checked
                                {% endif %}
                              >
                              {% if option_name_downcase == 'size' %}
                                <span class="btn btn--chip btn--box product-purchase__box">{{ value }}</span>
                              {% else %}
                                <span class="btn btn--chip product-purchase__pill">{{ value }}</span>
                              {% endif %}
                            </label>
                          {% endfor %}
                        </div>
                      </fieldset>
                    {% endfor %}
                    <script type="application/json">
                      {{ product.variants | json }}
                    </script>
                  </variant-selector>
                {% else %}
                  <div class="product-purchase__options" data-sample-variant-picker>
                    <div class="product-purchase__option-group">
                      <span class="product-purchase__option-label t2">Color</span>
                      <div class="product-purchase__option-values">
                        <button
                          type="button"
                          class="btn btn--chip product-purchase__pill"
                          data-option-group="color"
                          data-option-val="Burgundy"
                        >
                          Burgundy
                        </button>
                        <button
                          type="button"
                          class="btn btn--chip product-purchase__pill is-selected"
                          data-option-group="color"
                          data-option-val="Purple"
                        >
                          Purple
                        </button>
                        <button
                          type="button"
                          class="btn btn--chip product-purchase__pill"
                          data-option-group="color"
                          data-option-val="Grey"
                        >
                          Grey
                        </button>
                      </div>
                    </div>
                    <div class="product-purchase__option-group">
                      <span class="product-purchase__option-label t2">Size</span>
                      <div class="product-purchase__option-values product-purchase__option-values--size">
                        <button
                          type="button"
                          class="btn btn--chip btn--box product-purchase__box"
                          data-option-group="size"
                          data-option-val="S"
                        >
                          S
                        </button>
                        <button
                          type="button"
                          class="btn btn--chip btn--box product-purchase__box is-selected"
                          data-option-group="size"
                          data-option-val="M"
                        >
                          M
                        </button>
                        <button
                          type="button"
                          class="btn btn--chip btn--box product-purchase__box"
                          data-option-group="size"
                          data-option-val="L"
                        >
                          L
                        </button>
                        <button
                          type="button"
                          class="btn btn--chip btn--box product-purchase__box"
                          data-option-group="size"
                          data-option-val="XL"
                        >
                          XL
                        </button>
                      </div>
                    </div>
                  </div>
                {% endif %}
              </div>

            {% when 'buy_buttons' %}
              <div class="product-purchase__buy-buttons" {{ block.shopify_attributes }}>
                <product-form class="product-purchase__form-wrap">
                  {% form 'product', product, id: 'product-form-installment', class: 'product-purchase__form' %}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ product.selected_or_first_available_variant.id | default: 1 }}"
                    >
                    <input
                      type="hidden"
                      name="selling_plan"
                      value="{% if has_selling_plans and default_selling_plan %}{{ default_selling_plan.id }}{% endif %}"
                      data-selling-plan-input
                    >

                    {% assign is_available = product.selected_or_first_available_variant.available %}
                    {% if is_available == null %}
                      {% assign is_available = true %}
                    {% endif %}

                    <div class="product-purchase__actions">
                      {% unless product.requires_selling_plan %}
                        <button
                          type="submit"
                          name="add"
                          class="btn btn--secondary btn--full product-purchase__btn product-purchase__btn--one-time"
                          data-purchase-type="one-time"
                          {% unless is_available %}
                            disabled
                          {% endunless %}
                        >
                          + Add to Cart
                        </button>
                      {% endunless %}

                      {% if has_selling_plans %}
                        <button
                          type="button"
                          class="btn btn--primary btn--full product-purchase__btn product-purchase__btn--subscribe"
                          data-open-sub-modal
                          data-purchase-type="subscription"
                          data-original-text="Subscribe and Save"
                          {% unless is_available %}
                            disabled
                          {% endunless %}
                        >
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="product-purchase__btn-icon"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                          </svg>
                          <span>
                            {% if is_available %}
                              Subscribe and Save
                            {% else %}
                              SOLD OUT
                            {% endif %}
                          </span>
                        </button>
                      {% elsif product.requires_selling_plan %}
                        <button
                          type="button"
                          class="btn btn--primary btn--full product-purchase__btn product-purchase__btn--subscribe"
                          data-open-sub-modal
                          data-purchase-type="subscription"
                          data-original-text="Subscribe"
                          {% unless is_available %}
                            disabled
                          {% endunless %}
                        >
                          <span>
                            {% if is_available %}
                              Subscribe
                            {% else %}
                              SOLD OUT
                            {% endif %}
                          </span>
                        </button>
                      {% endif %}
                    </div>

                    {% if has_selling_plans %}
                      <div
                        class="subscription-modal hidden"
                        data-subscription-modal
                        aria-hidden="true"
                        role="dialog"
                        aria-modal="true"
                        aria-labelledby="sub-modal-title"
                      >
                        <div class="subscription-modal__backdrop" data-sub-modal-close></div>
                        <div class="subscription-modal__container">
                          <div class="subscription-modal__header">
                            <h2 id="sub-modal-title" class="subscription-modal__title t2">Select Frequency</h2>
                            <button
                              type="button"
                              class="btn-close subscription-modal__close"
                              data-sub-modal-close
                              aria-label="Close modal"
                            >
                              {% render 'icon-close' %}
                            </button>
                          </div>

                          <div
                            class="subscription-modal__options"
                            role="radiogroup"
                            aria-label="Subscription frequency options"
                          >
                            {% if product.selling_plan_groups.size > 0 %}
                              {% for plan in default_selling_plan_group.selling_plans %}
                                {% assign plan_discount = 0 %}
                                {% if plan.price_adjustments.size > 0 %}
                                  {% assign plan_discount = plan.price_adjustments[0].value %}
                                {% endif %}
                                {% assign discount_factor = 100 | minus: plan_discount %}
                                {% assign sub_cents = current_variant.price
                                  | times: discount_factor
                                  | divided_by: 100
                                %}
                                {% assign plan_sub_price = sub_cents
                                  | money_without_trailing_zeros
                                  | remove: '$'
                                  | remove: '£'
                                  | remove: '€'
                                  | strip
                                %}

                                <label
                                  class="subscription-modal__option {% if forloop.first %}is-selected{% endif %}"
                                  data-plan-card
                                >
                                  <input
                                    type="radio"
                                    name="modal_selling_plan"
                                    value="{{ plan.id }}"
                                    class="subscription-modal__radio"
                                    data-discount="{{ plan_discount }}"
                                    data-price="{{ plan_sub_price }}"
                                    {% if forloop.first %}
                                      checked
                                    {% endif %}
                                  >
                                  <span class="subscription-modal__radio-custom"></span>
                                  <span class="subscription-modal__name t2">
                                    {{- plan.options[0].value | default: plan.name -}}
                                  </span>
                                  <span class="subscription-modal__price">
                                    <span class="subscription-modal__amount t2"
                                      ><span data-card-price>{{ plan_sub_price }}</span
                                      ><span class="subscription-modal__currency t4">{{ currency_code }}</span></span
                                    >
                                    {% if plan_discount > 0 %}
                                      <span class="subscription-modal__discount"
                                        ><span>SAVE</span><span>{{ plan_discount }}%</span></span
                                      >
                                    {% endif %}
                                  </span>
                                </label>
                              {% endfor %}
                            {% else %}
                              <label class="subscription-modal__option is-selected" data-plan-card>
                                <input
                                  type="radio"
                                  name="modal_selling_plan"
                                  value="sample-1"
                                  class="subscription-modal__radio"
                                  data-discount="6"
                                  data-price="47.00"
                                  checked
                                >
                                <span class="subscription-modal__radio-custom"></span>
                                <span class="subscription-modal__name t2">1 Month</span>
                                <span class="subscription-modal__price">
                                  <span class="subscription-modal__amount t2"
                                    ><span data-card-price>47.00</span
                                    ><span class="subscription-modal__currency t4">{{ currency_code }}</span></span
                                  >
                                  <span class="subscription-modal__discount"><span>SAVE</span><span>6%</span></span>
                                </span>
                              </label>
                              <label class="subscription-modal__option" data-plan-card>
                                <input
                                  type="radio"
                                  name="modal_selling_plan"
                                  value="sample-2"
                                  class="subscription-modal__radio"
                                  data-discount="4"
                                  data-price="48.00"
                                >
                                <span class="subscription-modal__radio-custom"></span>
                                <span class="subscription-modal__name t2">2 Months</span>
                                <span class="subscription-modal__price">
                                  <span class="subscription-modal__amount t2"
                                    ><span data-card-price>48.00</span
                                    ><span class="subscription-modal__currency t4">{{ currency_code }}</span></span
                                  >
                                  <span class="subscription-modal__discount"><span>SAVE</span><span>4%</span></span>
                                </span>
                              </label>
                              <label class="subscription-modal__option" data-plan-card>
                                <input
                                  type="radio"
                                  name="modal_selling_plan"
                                  value="sample-3"
                                  class="subscription-modal__radio"
                                  data-discount="4"
                                  data-price="48.00"
                                >
                                <span class="subscription-modal__radio-custom"></span>
                                <span class="subscription-modal__name t2">3 Months</span>
                                <span class="subscription-modal__price">
                                  <span class="subscription-modal__amount t2"
                                    ><span data-card-price>48.00</span
                                    ><span class="subscription-modal__currency t4">{{ currency_code }}</span></span
                                  >
                                  <span class="subscription-modal__discount"><span>SAVE</span><span>4%</span></span>
                                </span>
                              </label>
                            {% endif %}
                          </div>

                          <div class="subscription-modal__footer">
                            <button
                              type="button"
                              class="btn btn--primary btn--full product-purchase__btn product-purchase__btn--subscribe"
                              data-sub-modal-confirm
                              data-original-text="Subscribe and Save"
                            >
                              <svg
                                width="10"
                                height="10"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="product-purchase__btn-icon"
                                aria-hidden="true"
                                focusable="false"
                              >
                                <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                              </svg>
                              <span data-sub-confirm-text>Subscribe and Save</span>
                            </button>
                          </div>
                        </div>
                      </div>
                    {% endif %}
                  {% endform %}
                </product-form>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </product-gallery>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "category",
      "name": "Category",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "ingredients",
      "name": "Ingredients List",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy & Subscribe Buttons",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Product Information",
      "blocks": [
        { "type": "category" },
        { "type": "title" },
        { "type": "price" },
        { "type": "description" },
        { "type": "ingredients" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
