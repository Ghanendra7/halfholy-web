<section class="w-full bg-[#EFEFEF] hairline-b">
  <!-- Top Editorial Notice Bar (Optional / Configurable) -->
  {% if section.settings.show_brand_statement %}
    <div class="w-full px-6 md:px-8 py-6 hairline-b">
      <div class="max-w-xl text-xs leading-relaxed text-[#333333]">
        <p>{{ section.settings.brand_statement }}</p>
        {% if section.settings.brand_email != blank %}
          <p class="mt-2 text-[#0A0A0A] font-mono">{{ section.settings.brand_email }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-12 min-h-screen">
    <!-- LEFT: Sticky Product Media Gallery (7 cols) -->
    <div class="lg:col-span-7 lg:hairline-r p-6 md:p-10 flex gap-6 lg:sticky lg:top-14 lg:self-start lg:max-h-[calc(100vh-3.5rem)] overflow-hidden">
      <!-- Vertical Thumbnails -->
      {% if product.media.size > 1 %}
        <div class="hidden md:flex flex-col gap-2 shrink-0 w-12 overflow-y-auto max-h-[70vh]">
          {% for media in product.media %}
            <button 
              type="button" 
              class="w-12 h-16 bg-[#E8E8E8] hairline-all p-1 hover:border-[#8000FF] transition-colors {% if forloop.first %}border-purple-active{% endif %}"
              onclick="document.getElementById('product-media-{{ media.id }}').scrollIntoView({behavior: 'smooth', block: 'nearest'})"
              aria-label="View media {{ forloop.index }}"
            >
              {{ media | image_url: width: 100 | image_tag: class: 'w-full h-full object-contain', loading: 'lazy' }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Main Display -->
      <div class="flex-1 flex flex-col items-center justify-center overflow-y-auto max-h-[75vh] space-y-8">
        {% for media in product.media %}
          <div id="product-media-{{ media.id }}" data-media-id="{{ media.id }}" class="w-full flex items-center justify-center">
            {{ media | image_url: width: 1200 | image_tag: 
              class: 'max-h-[65vh] w-auto object-contain', 
              loading: 'eager',
              fetchpriority: 'high'
            }}
          </div>
        {% else %}
          <div class="w-full h-[50vh] flex items-center justify-center bg-[#E5E5E5] text-xs font-mono text-[#888888]">
            PRODUCT PREVIEW MEDIA
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT: Product Details & Buying Actions (5 cols) -->
    <div class="lg:col-span-5 p-6 md:p-12 flex flex-col justify-start space-y-6">
      {% for block in section.blocks %}
        {% case block.type %}

          {% when '@app' %}
            <div class="my-4" {{ block.shopify_attributes }}>
              {% render block %}
            </div>

          {% when 'category' %}
            <div {{ block.shopify_attributes }}>
              <span class="text-xs text-[#777777] uppercase font-mono tracking-wider">
                {{ product.type | default: 'Lip Products' }}
              </span>
            </div>

          {% when 'title' %}
            <div {{ block.shopify_attributes }}>
              <h1 class="text-2xl md:text-3xl font-normal tracking-tight text-[#0A0A0A]">
                {{ product.title }}
              </h1>
            </div>

          {% when 'price' %}
            <div {{ block.shopify_attributes }}>
              <div data-product-price class="text-sm font-mono tracking-wide text-[#0A0A0A]">
                {{ product.selected_or_first_available_variant.price | money }}
              </div>
            </div>

          {% when 'description' %}
            <div class="text-xs leading-relaxed text-[#333333] max-w-lg" {{ block.shopify_attributes }}>
              {{ product.description }}
            </div>

          {% when 'ingredients' %}
            <div class="p-4 bg-[#E8E8E8] hairline-all text-[10px] font-mono uppercase tracking-widest text-[#444444] space-y-1" {{ block.shopify_attributes }}>
              <span class="block text-[#0A0A0A] font-semibold mb-1">INGREDIENTS / COMPOSITION</span>
              {% if product.metafields.custom.ingredients != blank %}
                {{ product.metafields.custom.ingredients | newline_to_br }}
              {% else %}
                <p>CERAMIDE NP</p>
                <p>SQUALANE, BUTYROSPERMUM PARKII</p>
                <p>SHEA BUTTER</p>
                <p>BIS-DIGLYCERYL POLYACYLADIPATE-2</p>
                <p>RICINUS COMMUNIS SEED OIL</p>
                <p>BUTYROSPERMUM PARKII BUTTER</p>
              {% endif %}
            </div>

          {% when 'variant_picker' %}
            <div {{ block.shopify_attributes }}>
              {% unless product.has_only_default_variant %}
                <variant-selector data-url="{{ product.url }}" class="block space-y-4">
                  {% for option in product.options_with_values %}
                    <fieldset class="space-y-2">
                      <legend class="text-[11px] font-mono uppercase tracking-wider text-[#666666]">
                        {{ option.name }}
                      </legend>
                      <div class="flex flex-wrap gap-2">
                        {% for value in option.values %}
                          <label class="cursor-pointer">
                            <input 
                              type="radio" 
                              name="{{ option.name }}" 
                              value="{{ value | escape }}" 
                              class="sr-only peer"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <span class="inline-flex items-center justify-center px-3 py-1.5 text-xs font-mono uppercase hairline-all bg-transparent peer-checked:bg-[#8000FF] peer-checked:text-white peer-checked:border-[#8000FF] hover:border-black transition-colors">
                              {{ value }}
                            </span>
                          </label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endfor %}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-selector>
              {% endunless %}
            </div>

          {% when 'buy_buttons' %}
            <div {{ block.shopify_attributes }}>
              <product-form class="block w-full">
                {% form 'product', product, id: 'product-form-installment' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  
                  <div class="space-y-3">
                    <!-- One Time Purchase / Secondary Button -->
                    <button 
                      type="submit" 
                      name="add" 
                      class="w-full bg-transparent hairline-all py-3 px-6 text-xs font-mono tracking-widest uppercase hover:bg-black hover:text-white transition-colors cursor-pointer text-[#0A0A0A]"
                    >
                      {{ 'products.product.one_time_purchase' | t }}
                    </button>

                    <!-- Subscribe and Save Primary CTA Button -->
                    <button 
                      type="submit" 
                      name="add" 
                      data-add-to-cart-btn
                      data-original-text="{{ 'products.product.subscribe_and_save' | t }}"
                      class="w-full bg-[#8000FF] hover:bg-[#7000E0] text-white py-3.5 px-6 text-xs font-mono tracking-widest uppercase flex items-center justify-center space-x-2 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                    >
                      <span>↻</span>
                      <span>
                        {% if product.selected_or_first_available_variant.available %}
                          {{ 'products.product.subscribe_and_save' | t }}
                        {% else %}
                          {{ 'products.product.sold_out' | t }}
                        {% endif %}
                      </span>
                    </button>
                  </div>
                {% endform %}
              </product-form>
            </div>

          {% when 'accordion' %}
            <div class="hairline-t pt-2" {{ block.shopify_attributes }}>
              <accordion-drawer class="block">
                <details class="group py-2">
                  <summary class="flex items-center justify-between cursor-pointer text-xs font-mono uppercase tracking-wider py-1 hover:opacity-60">
                    <span>{{ block.settings.title }}</span>
                    <span data-accordion-icon class="text-sm font-mono">+</span>
                  </summary>
                  <div class="pt-3 pb-2 text-xs leading-relaxed text-[#444444]">
                    {{ block.settings.content }}
                    {% if block.settings.show_manual_links %}
                      <div class="mt-3 flex gap-4 text-[11px] font-mono uppercase text-[#0A0A0A]">
                        <a href="{{ block.settings.manual_en_url | default: '#' }}" class="underline hover:text-[#8000FF]">English</a>
                        <a href="{{ block.settings.manual_de_url | default: '#' }}" class="underline hover:text-[#8000FF]">German</a>
                        <a href="{{ block.settings.manual_fr_url | default: '#' }}" class="underline hover:text-[#8000FF]">French</a>
                      </div>
                    {% endif %}
                  </div>
                </details>
              </accordion-drawer>
            </div>

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_brand_statement",
      "label": "Show Top Brand Statement",
      "default": true
    },
    {
      "type": "textarea",
      "id": "brand_statement",
      "label": "Brand Statement Text",
      "default": "halfholy is a beauty house built on ceremony. We make everyday relics — products that live on the skin as sensation and objects designed to be used, kept, and looked at. the act of caring for yourself as something sacred."
    },
    {
      "type": "text",
      "id": "brand_email",
      "label": "Brand Contact Email",
      "default": "contact@halfholy.nyc"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "category",
      "name": "Category",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "ingredients",
      "name": "Ingredients List",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy & Subscribe Buttons",
      "limit": 1
    },
    {
      "type": "accordion",
      "name": "Collapsible Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "HOW TO USE"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>The brand's first offering is an everyday, unisex, non-seasonal lip balm designed to elevate an essential, often overlooked product into a sacred ritual.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_manual_links",
          "label": "Show Manual Language Links",
          "default": false
        },
        {
          "type": "url",
          "id": "manual_en_url",
          "label": "English Manual File URL"
        },
        {
          "type": "url",
          "id": "manual_de_url",
          "label": "German Manual File URL"
        },
        {
          "type": "url",
          "id": "manual_fr_url",
          "label": "French Manual File URL"
        }
      ]
    }
  ]
}
{% endschema %}
