{% if cart.item_count > 0 %}
  <ul class="divide-y divide-[#CBD0D3]">
    {% for item in cart.items %}
      <li class="py-4 flex gap-4">
        {% if item.image %}
          <div class="w-20 h-24 bg-white border border-[#CBD0D3] shrink-0 p-1">
            {{ item.image | image_url: width: 200 | image_tag: class: 'w-full h-full object-contain', loading: 'lazy' }}
          </div>
        {% endif %}
        <div class="flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-xs uppercase font-medium">{{ item.product.title }}</h3>
            {% unless item.product.has_only_default_variant %}
              <p class="text-[10px] uppercase font-mono text-[#666666] mt-0.5">{{ item.variant.title }}</p>
            {% endunless %}
            <p class="text-[11px] font-mono mt-1">{{ item.final_price | money }}</p>
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono mt-2">
            <span>Qty: {{ item.quantity }}</span>
            <button type="button" data-cart-remove data-line="{{ forloop.index }}" class="underline hover:opacity-60 cursor-pointer bg-transparent border-none p-0 text-inherit">Remove</button>
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
{% else %}
  <div class="py-16 text-center">
    <p class="text-xs font-mono uppercase text-[#666666]">Your bag is currently empty.</p>
  </div>
{% endif %}

{% schema %}
{
  "name": "Cart Drawer Items",
  "settings": []
}
{% endschema %}
