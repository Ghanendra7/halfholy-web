<cart-drawer class="cart-drawer hidden" aria-modal="true" role="dialog" aria-label="Cart">
  <div data-cart-overlay class="cart-drawer__overlay"></div>

  <div class="cart-drawer__wrapper">
    <div class="cart-drawer__panel">
      
      <div class="cart-drawer__header">
        <h2 class="cart-drawer__title t2-fixed">
          Cart <span class="cart-drawer__count" data-cart-count>({{ cart.item_count }})</span>
        </h2>
        <button data-cart-close type="button" class="cart-drawer__close" aria-label="Close Cart">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <line x1="9.38678" y1="0.386844" x2="0.901501" y2="8.87212" stroke-width="0.4" stroke="currentColor"/>
            <line x1="9.09845" y1="8.8722" x2="0.613166" y2="0.386913" stroke-width="0.4" stroke="currentColor"/>
          </svg>
        </button>
      </div>

      <div data-cart-items-container class="cart-drawer__content">
        {% render 'cart-drawer-inner' %}
      </div>

    </div>
  </div>
</cart-drawer>