<cart-drawer class="cart-drawer hidden" aria-modal="true" role="dialog" aria-label="Shopping Bag">
  <div data-cart-overlay class="cart-drawer__overlay"></div>

  <div class="cart-drawer__wrapper">
    <div class="cart-drawer__panel">
      
      <div class="cart-drawer__header">
        <h2 class="cart-drawer__title">
          Shopping Bag <span class="cart-drawer__count" data-cart-count>({{ cart.item_count }})</span>
        </h2>
        <button data-cart-close type="button" class="cart-drawer__close" aria-label="Close Shopping Bag">
          [Close]
        </button>
      </div>

      <div data-cart-items-container class="cart-drawer__content">
        {% render 'cart-drawer-inner' %}
      </div>

    </div>
  </div>
</cart-drawer>