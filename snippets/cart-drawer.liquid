<cart-drawer class="hidden fixed inset-0 z-50 overflow-hidden" aria-modal="true" role="dialog">
  <!-- Backdrop -->
  <div data-cart-overlay class="fixed inset-0 bg-black/40 backdrop-blur-xs transition-opacity duration-300"></div>

  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-[#E6E9EA] text-[#0A0A0A] border-l border-[#CBD0D3] flex flex-col shadow-2xl">
      <!-- Drawer Header -->
      <div class="p-6 hairline-b flex items-center justify-between">
        <h2 class="text-xs uppercase font-mono tracking-widest">Shopping Bag</h2>
        <button data-cart-close type="button" class="text-xs font-mono tracking-widest uppercase hover:opacity-60 cursor-pointer">
          [Close]
        </button>
      </div>

      <!-- Drawer Content -->
      <div data-cart-items-container class="flex-1 overflow-y-auto p-6 space-y-6">
        {% if cart.item_count > 0 %}
          <ul class="divide-y divide-[#CBD0D3]">
            {% for item in cart.items %}
              <li class="py-4 flex gap-4">
                {% if item.image %}
                  <div class="w-20 h-24 bg-white border border-[#CBD0D3] shrink-0 p-1">
                    {{ item.image | image_url: width: 200 | image_tag: class: 'w-full h-full object-contain', loading: 'lazy' }}
                  </div>
                {% endif %}
                <div class="flex-1 flex flex-col justify-between">
                  <div>
                    <h3 class="text-xs uppercase font-medium">{{ item.product.title }}</h3>
                    {% unless item.product.has_only_default_variant %}
                      <p class="text-[10px] uppercase font-mono text-[#666666] mt-0.5">{{ item.variant.title }}</p>
                    {% endunless %}
                    <p class="text-[11px] font-mono mt-1">{{ item.final_price | money }}</p>
                  </div>
                  <div class="flex items-center justify-between text-[10px] font-mono mt-2">
                    <span>Qty: {{ item.quantity }}</span>
                    <button type="button" data-cart-remove data-line="{{ forloop.index }}" class="underline hover:opacity-60 cursor-pointer bg-transparent border-none p-0 text-inherit">Remove</button>
                  </div>
                </div>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="py-16 text-center">
            <p class="text-xs font-mono uppercase text-[#666666]">Your bag is currently empty.</p>
          </div>
        {% endif %}
      </div>

      <!-- Drawer Footer -->
      <div class="p-6 hairline-t space-y-4">
        <div class="flex justify-between text-xs font-mono uppercase tracking-wider">
          <span>Subtotal</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="text-[10px] font-mono uppercase text-[#666666]">Shipping & taxes calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="w-full bg-[#9022B8] hover:bg-[#7E1DA2] text-white py-3 px-6 text-xs font-mono tracking-widest uppercase transition-colors cursor-pointer">
            Proceed to Checkout
          </button>
        </form>
      </div>
    </div>
  </div>
</cart-drawer>
