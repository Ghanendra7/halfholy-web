{% if cart.item_count > 0 %}
  <div class="cart-drawer__body">
    <ul class="cart-drawer__items" role="list">
      {% for item in cart.items %}
        <li class="cart-drawer__item" data-line="{{ forloop.index }}">
          <a href="{{ item.url }}" class="cart-drawer__item-media" aria-label="{{ item.title | escape }}">
            {% if item.image %}
              {{
                item.image
                | image_url: width: 240
                | image_tag: class: 'cart-drawer__item-image', loading: 'lazy', decoding: 'async', alt: item.title
                | escape
              }}
            {% else %}
              <div class="cart-drawer__item-placeholder"></div>
            {% endif %}
          </a>

          <div class="cart-drawer__item-details">
            <div class="cart-drawer__item-header">
              <a href="{{ item.url }}" class="cart-drawer__item-title">
                {{ item.product.title }}
              </a>
              <span class="cart-drawer__item-price">
                {{
                  item.final_line_price
                  | money_without_trailing_zeros
                  | remove: '$'
                  | remove: '£'
                  | remove: '€'
                  | strip
                }}
                <span class="cart-drawer__item-currency">{{ cart.currency.iso_code }}</span>
              </span>
            </div>

            {% unless item.product.has_only_default_variant %}
              <div class="cart-drawer__item-variant">
                {{ item.variant.title }}
              </div>
            {% endunless %}

            {% if item.selling_plan_allocation %}
              {% assign plan_title = item.selling_plan_allocation.selling_plan.name %}
              {% if plan_title contains '% off' or plan_title contains '% OFF' %}
                {% assign parts = plan_title | split: ',' %}
                {% assign freq_text = parts[0] | strip %}
                {% assign disc_text = parts[1] | remove: 'off' | remove: 'OFF' | strip %}
                {% assign plan_title = freq_text | append: ', SAVE ' | append: disc_text %}
              {% endif %}
              <div class="cart-drawer__item-subscription t6">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cart-drawer__item-subscription-icon" aria-hidden="true" focusable="false">
                  <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
                </svg>
                <span>{{ plan_title }}</span>
              </div>
            {% endif %}

            <div class="cart-drawer__item-actions">
              <div class="cart-drawer__qty-control" role="group" aria-label="Quantity selector">
                <button
                  type="button"
                  class="cart-drawer__qty-btn"
                  data-cart-qty-change="-1"
                  data-line="{{ forloop.index }}"
                  data-current-qty="{{ item.quantity }}"
                  aria-label="Decrease quantity"
                >
                  −
                </button>
                <span class="cart-drawer__qty-value" aria-live="polite">{{ item.quantity }}</span>
                <button
                  type="button"
                  class="cart-drawer__qty-btn"
                  data-cart-qty-change="1"
                  data-line="{{ forloop.index }}"
                  data-current-qty="{{ item.quantity }}"
                  aria-label="Increase quantity"
                >
                  +
                </button>
              </div>

              <button
                type="button"
                class="cart-drawer__item-remove"
                data-cart-remove
                data-line="{{ forloop.index }}"
                aria-label="Remove {{ item.title | escape }}"
              >
                Remove
              </button>
            </div>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="cart-drawer__footer">
    <div class="cart-drawer__summary-row">
      <span class="cart-drawer__summary-label">Subtotal</span>
      <span class="cart-drawer__summary-value" data-cart-subtotal>
        {{ cart.total_price | money_without_trailing_zeros | remove: '$' | remove: '£' | remove: '€' | strip }}
        <span class="cart-drawer__summary-currency">{{ cart.currency.iso_code }}</span>
      </span>
    </div>

    <p class="cart-drawer__tax-note">Shipping & taxes calculated at checkout</p>

    <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form">
      <button type="submit" name="checkout" class="btn btn--primary btn--full cart-drawer__checkout-btn">
        Proceed to Checkout
      </button>
    </form>
  </div>
{% else %}
  <div class="cart-drawer__empty">
    <p class="cart-drawer__empty-text">Your cart is currently empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline cart-drawer__empty-btn">
      Explore Shop
    </a>
  </div>
{% endif %}
